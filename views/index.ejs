<!DOCTYPE html>
<html>
<head>
    <title>Student Management</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="container">
        <h1>Student Management System</h1>
        
        <div class="toolbar">
            <a href="/students/add" class="btn-primary">Add Student</a>
            
            <form action="/students/search" method="GET">
                <input 
                    type="text" 
                    name="keyword" 
                    placeholder="Search student..."
                >
                <button type="submit">Search</button>
            </form>
        </div>

        <hr>

        <h2>Student List</h2>
        <div class="table-responsive">
            <table border="1" cellpadding="10">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Student ID</th>
                        <th>Name</th>
                        <th>Course</th>
                        <th>Year</th>
                        <th>Email</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% students.forEach(student => { %>
                    <tr>
                        <td><%= student.id %></td>
                        <td><%= student.student_id %></td>
                        <td><%= student.first_name %> <%= student.last_name %></td>
                        <td><%= student.course %></td>
                        <td><%= student.year_level %></td>
                        <td><%= student.email %></td>
                        <td>
                            <a href="/students/edit/<%= student.id %>" style="background-color: #f59e0b; color: white; padding: 5px 10px; text-decoration: none; border-radius: 4px; font-size: 13px; margin-right: 5px;">Edit</a>
                            <form action="/students/delete/<%= student.id %>" method="POST" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this student?');">
                                <button type="submit" style="background-color: #dc2626; color: white; border: none; padding: 5px 10px; border-radius: 4px; cursor: pointer; font-size: 13px;">Delete</button>
                            </form>
                        </td>
                    </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>